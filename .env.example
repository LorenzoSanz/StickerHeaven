NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Poner a true si usas un proxy inverso (Nginx)
# TRUST_PROXY=false 

# Auth (NextAuth / Auth.js)
# AUTH_SECRET debe tener al menos 32 caracteres. Puedes generar uno con: openssl rand -base64 32
# AUTH_SECRET=CHANGE_ME_MIN_32_CHARS________________________________

# Database
DATABASE_URL=mongodb://localhost:27017/stickerheaven
# DNS_SERVERS=1.1.1.1,8.8.8.8 # Descomenta si tienes problemas de conexión con MongoDB Atlas (ej. en redes Movistar)

# Cloudinary (Gestión de Imágenes)
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Stripe (Pagos)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me

# Business
CURRENCY=EUR

# Server
PORT=3001

# Cache y Rate Limiting (Opcional)
# REDIS_URL=redis://localhost:6379 # Si no se define, se usará almacenamiento en memoria

# Email (Testing/Notificaciones)
EMAIL_PROVIDER=console

# Activar SMTP para verlo en Interfaz con mailpit u otro servicio
# EMAIL_PROVIDER=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=no-reply@stickerheaven.local
# SMTP_USER=
# SMTP_PASS=

# Seed (bun seed): admin password; if empty a random one is generated and printed
# SEED_ADMIN_PASSWORD=
