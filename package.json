{
  "name": "sticker-heaven",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev:api": "bun --watch src/server/node.ts",
    "dev:web": "next dev",
    "dev": "echo 'Usa las dos terminales: bun run dev:api AND bun run dev:web'",
    "build": "next build",
    "start:api": "NODE_ENV=production bun src/server/node.ts",
    "start:web": "NODE_ENV=production next start",
    "seed": "bun scripts/seed.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "depcruise": "bunx depcruise --config ./tools/dependency-cruiser.config.cjs src"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@hono/zod-validator": "^0.7.6",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "argon2": "^0.40.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "lucide-react": "^0.562.0",
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^4.7.1",
    "stripe": "~20.2.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "latest",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "latest",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
