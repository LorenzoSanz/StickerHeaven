{
  "name": "sticker-heaven",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev:api": "bun --watch src/server/node.ts",
    "dev:web": "next dev",
    "dev": "echo 'Usa las dos terminales: bun run dev:api AND bun run dev:web'",
    "build": "next build",
    "start:api": "NODE_ENV=production bun src/server/node.ts",
    "start:web": "NODE_ENV=production next start",
    "seed": "bun scripts/seed.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "depcruise": "bunx depcruise --config ./tools/dependency-cruiser.config.cjs src"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.3",
    "argon2": "^0.40.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "hono": "^4.2.0",
    "lucide-react": "^0.562.0",
    "mongoose": "^9.1.5",
    "next": "^16.0.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^4.7.0",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "latest",
    "@types/node": "^20.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "latest",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.4.0"
  }
}
