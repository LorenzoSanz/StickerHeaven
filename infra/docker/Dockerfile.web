FROM oven/bun:1.1.29-alpine AS build

WORKDIR /app

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG API_URL

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV API_URL=$API_URL
ENV NODE_ENV=production

COPY package.json bun.lock next.config.ts tsconfig.json next-env.d.ts postcss.config.js eslint.config.mjs ./
COPY public ./public
COPY src ./src
COPY scripts ./scripts

RUN bun install --frozen-lockfile
RUN bun run build

FROM oven/bun:1.1.29-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=bun:bun /app ./
USER bun

EXPOSE 3000

CMD ["bun", "next", "start", "-p", "3000"]

