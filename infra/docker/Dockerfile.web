FROM oven/bun:1.3.14-alpine AS build

WORKDIR /app

ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG API_URL

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV API_URL=$API_URL
ENV NODE_ENV=production

COPY package.json bun.lock next.config.ts tsconfig.json next-env.d.ts postcss.config.js eslint.config.mjs ./
COPY public ./public
COPY src ./src
COPY scripts ./scripts

RUN bun install --frozen-lockfile
RUN bun run build

FROM oven/bun:1.3.14-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
# The standalone server listens on HOSTNAME:PORT; 0.0.0.0 makes it reachable from nginx.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Only the standalone server, its traced dependencies and the static assets: no source,
# no dev dependencies and no build cache in the runtime image.
COPY --from=build --chown=bun:bun /app/.next/standalone ./
COPY --from=build --chown=bun:bun /app/.next/static ./.next/static
COPY --from=build --chown=bun:bun /app/public ./public
USER bun

EXPOSE 3000

CMD ["bun", "server.js"]
